# Example .env file for deployment
# DO NOT commit this file to GitHub!

# MongoDB Connection
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/ai_content_verifier

# JWT Secret (generate a secure random string)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here

# CORS Origins (comma-separated for multiple origins)
CORS_ORIGINS=https://your-app-name.netlify.app

# Optional: Email configuration (if using email features)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
